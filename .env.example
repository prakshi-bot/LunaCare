# ==========================================
# LunaCare Environment Variables Template
# ==========================================
# Copy this file to .env and insert your real Gemini API key
# NEVER commit your real .env file to Git!

# Google Gemini API Key (Obtain from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# LLM Model Name for Generative Answers
MODEL_NAME=gemini-3.6-flash

# Generation Parameters
TEMPERATURE=0.3
MAX_OUTPUT_TOKENS=1024

# Phase 3 RAG & Embedding Settings
EMBEDDING_MODEL=gemini-embedding-2
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=4
# Cosine distance threshold for similarity search (lower distance = higher relevance)
SIMILARITY_DISTANCE_THRESHOLD=0.70

# Phase 4 Conversational Memory Window (max recent turns sent to Gemini, excluding greeting)
MEMORY_WINDOW=8

# Application Environment (development / production)
ENVIRONMENT=development
